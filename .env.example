# TraceWeaver configuration template. Backend foundation is implemented.
# Startup requires DATABASE_URL and CURSOR_SECRET. Scorer settings remain reserved.
APP_ENV=development
API_HOST=127.0.0.1
FRONTEND_PORT=3000
# Optional comma-separated exact browser origins. Local defaults follow FRONTEND_PORT.
# Production defaults to disabled; configure HTTPS origins explicitly. Callback: /auth/callback.
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8080
DB_POOL_MAX=5
SHUTDOWN_TIMEOUT_MS=10000
IDENTITY_PORT=8081
OIDC_ISSUER=http://localhost:8081/realms/traceweaver
OIDC_CLIENT_ID=traceweaver-web
OIDC_API_AUDIENCE=traceweaver-api
# By default JWKS uses OIDC_ISSUER + /protocol/openid-connect/certs.
# Omit OIDC_JWKS_URI unless the provider uses a different trusted endpoint.
OIDC_TIMEOUT_MS=2000
CURSOR_SECRET=
POSTGRES_DB=traceweaver
POSTGRES_USER=traceweaver_app
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
DATABASE_URL=
INGEST_CLIENT_ID=traceweaver-ingest
INGEST_CLIENT_SECRET=
# Internal workflow service: distinct confidential OIDC client and exact service-account sub.
# Empty CORE_APP_SUBJECT disables core HTTP (503). Service requires workspace membership.
CORE_APP_CLIENT_ID=traceweaver-core
CORE_APP_SUBJECT=
SCORER_INTERNAL_URL=http://ai:8000
SCORER_SERVICE_SECRET=
MODEL_PATH=/models/scorer
MODEL_SHA256=
INGEST_MAX_EVENTS=500
INGEST_MAX_BYTES=1048576
RUN_MAX_EVENTS=1000
RUN_MAX_WINDOW_SECONDS=3600
AI_TIMEOUT_MS=5000
# Never add oracle paths or fixed demo passwords here.

# Optional loopback scorer adapter (full endpoint); use same private secret as Python.
# SCORER_URL=http://127.0.0.1:8000/internal/v1/score-pairs
# SCORER_SERVICE_SECRET=replace-with-random-at-least-32-printable-ascii-characters
SCORER_TIMEOUT_MS=5000
# Experimental trained v2 requires explicit opt-in on BE and model selection on Python.
# Empty/omitted SCORER_MODEL_VERSION keeps the baseline-only adapter.
# SCORER_MODEL_VERSION=logistic-regression-sandbox-features-2-experiment-1
# SCORER_MODE=model
# SCORER_MODEL_PATH=ai/artifacts/sandbox-v2/model_sandbox_v2.json
