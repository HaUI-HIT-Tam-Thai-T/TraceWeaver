# TraceWeaver configuration template. Backend foundation is implemented.
# Backend startup requires DATABASE_URL and CURSOR_SECRET.
# AI scorer runs independently; backend-to-scorer integration is still pending.
APP_ENV=development
API_HOST=127.0.0.1
FRONTEND_PORT=3000
API_PORT=8080
DB_POOL_MAX=5
SHUTDOWN_TIMEOUT_MS=10000
IDENTITY_PORT=8081
OIDC_ISSUER=http://localhost:8081/realms/traceweaver
OIDC_CLIENT_ID=traceweaver-web
OIDC_API_AUDIENCE=traceweaver-api
# By default JWKS uses OIDC_ISSUER + /protocol/openid-connect/certs.
# Omit OIDC_JWKS_URI unless the provider uses a different trusted endpoint.
OIDC_TIMEOUT_MS=2000
CURSOR_SECRET=
POSTGRES_DB=traceweaver
POSTGRES_USER=traceweaver_app
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
DATABASE_URL=
INGEST_CLIENT_ID=traceweaver-ingest
INGEST_CLIENT_SECRET=
SCORER_INTERNAL_URL=http://ai:8000
SCORER_SERVICE_SECRET=
# Independent AI service: model verifies the artifact and its sibling manifest.
# For local baseline demo, explicitly export SCORER_MODE=baseline (see ai/RUN.md).
SCORER_MODE=model
SCORER_HOST=127.0.0.1
SCORER_PORT=8000
SCORER_MODEL_PATH=ai/artifacts/model_v1.json
# Reserved deployment placeholders; the current AI loader uses SCORER_MODEL_PATH.
MODEL_PATH=/models/scorer
MODEL_SHA256=
INGEST_MAX_EVENTS=500
INGEST_MAX_BYTES=1048576
RUN_MAX_EVENTS=1000
RUN_MAX_WINDOW_SECONDS=3600
AI_TIMEOUT_MS=5000
# Never add oracle paths or fixed demo passwords here.
