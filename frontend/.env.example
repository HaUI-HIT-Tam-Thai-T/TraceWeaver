# Copy to .env.production.local for production builds.
# VITE_* values are public and included in the browser bundle. No secrets.
# API base is the origin only; services will append /api/v1/...
VITE_API_BASE_URL=https://api.quizlearn.tech
VITE_KEYCLOAK_URL=https://api.quizlearn.tech/identity
VITE_KEYCLOAK_REALM=traceweaver
VITE_KEYCLOAK_CLIENT_ID=traceweaver-web

# Development proxy only; not exposed to the browser.
API_PROXY_TARGET=https://api.quizlearn.tech
