{
  "name": "traceweaver",
  "version": "0.1.0-base.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev:be": "npm run dev --workspace=@traceweaver/backend",
    "start:be": "npm run start --workspace=@traceweaver/backend",
    "db:migrate": "npm run db:migrate --workspace=@traceweaver/backend",
    "db:setup": "node backend/scripts/setup-local-env.js",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait --pull never postgres",
    "db:stop": "docker compose -f compose.dev.yaml stop postgres",
    "test:db": "node --env-file-if-exists=.env --test backend/tests/integration/*.test.js",
    "test:contracts": "node --test backend/tests/contracts/*.test.js",
    "test:identity": "node --env-file-if-exists=.env --test backend/tests/identity/*.test.js",
    "test:identity:native": "node --env-file-if-exists=.env --import ./backend/tests/support/oidc-native-loader.js --test --test-concurrency=1 backend/tests/identity/*.test.js",
    "test": "node --test backend/tests/backend/*.test.js backend/tests/contracts/*.test.js",
    "check:base": "node backend/scripts/check-base.js",
    "licenses": "node backend/scripts/dependency-inventory.js",
    "licenses:check": "node backend/scripts/dependency-inventory.js --check",
    "smoke": "node backend/scripts/smoke.js"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HaUI-HIT-Tam-Thai-T/TraceWeaver.git"
  },
  "bugs": {
    "url": "https://github.com/HaUI-HIT-Tam-Thai-T/TraceWeaver/issues"
  }
}
