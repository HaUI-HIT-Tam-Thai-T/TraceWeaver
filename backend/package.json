{
  "name": "@traceweaver/backend",
  "version": "0.1.0-base.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.{js,mjs,cjs}\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "swagger-ui-dist": "5.34.0"
  }
}
