      "ingestBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Ingest service access token with explicit source scope; not a user read token."
      },
      "appServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Internal app service plus trusted validated end-user context."
      },
