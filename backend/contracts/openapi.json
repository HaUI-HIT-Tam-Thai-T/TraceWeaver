      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": "Optional for initial creation, required to retry POST safely. Actor+workspace+route scoped for 24h; same key/body replays response; changed body returns 409."
      }
